{
  "name": "cordova-plugin-herosignal",
  "version": "0.1.0",
  "description": "HeroSignal Cordova eklentisi: push bildirimi, kullanıcı/tag, e-posta/SMS, in-app mesaj ve bildirim kutusu",
  "license": "MIT",
